# Copy this file to ".env" and fill in real values.
# ".env" is gitignored and must never be committed.

# --- GitHub (needed NOW: push branch, open PR, capture the fixture) ---
# Classic PAT with "repo" scope, OR a fine-grained PAT scoped to this repo
# with Contents=read/write and Pull requests=read/write.
GITHUB_TOKEN=

# --- Gemini / Google AI Studio (needed LATER: swap mock -> real model) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default chosen in code later).
GEMINI_MODEL=gemini-2.5-flash

# --- Langfuse (observability/tracing — spec 05; optional, off if unset) ---
# Project keys from cloud.langfuse.com -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region host, e.g. https://cloud.langfuse.com or https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
